!.yarn/releases
!.yarn/versions

# --- build output ---------------------------------------------------------
.next/
out/
build/
dist/
.open-next/

# --- environment ----------------------------------------------------------
# .env.example is tracked on purpose: it documents every variable the app reads
# (NEXT_PUBLIC_SPLINE_SCENE_URL, NEXT_PUBLIC_CONTENT_SOURCE, …) without any values.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# --- typescript -----------------------------------------------------------
*.tsbuildinfo
next-env.d.ts

# --- test / coverage ------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/

# --- logs -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- caches ---------------------------------------------------------------
.wrangler/
.turbo/
.eslintcache
.cache/
