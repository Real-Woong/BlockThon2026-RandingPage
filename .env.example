# 어떤 콘텐츠를 렌더링할지 고릅니다.
#
#   real — content/event.ts 에 채운 확정 정보만. 배포는 반드시 이 값입니다.
#   mock — content/mock.ts 의 가짜 데이터. 레이아웃 확인용이고 기본값입니다.
#
# ⚠️ 비워두면 mock 으로 동작합니다. 즉 이 값을 설정하지 않고 배포하면
#    지어낸 날짜·상금·트랙이 그대로 공개됩니다.
NEXT_PUBLIC_CONTENT_SOURCE="mock"

# Spline scene URL. Leave empty until an official scene exists.
# When empty, the hero renders the CSS protocol field fallback.
NEXT_PUBLIC_SPLINE_SCENE_URL=""

# Optional override for the Spline viewer web component bundle.
NEXT_PUBLIC_SPLINE_VIEWER_SRC=""
